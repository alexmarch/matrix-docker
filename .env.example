# Use hostnames with DNS A/AAAA records pointing to this server.
MATRIX_SERVER_NAME=matrix.example.com
ELEMENT_DOMAIN=chat.example.com
ADMIN_DOMAIN=admin.example.com
TURN_DOMAIN=turn.example.com
TURN_PUBLIC_IP=REPLACE_WITH_PUBLIC_IPV4

# Generate three different 32+ character hex secrets; never reuse these values.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
TURN_SHARED_SECRET=REPLACE_WITH_RANDOM_HEX
REGISTRATION_SHARED_SECRET=REPLACE_WITH_RANDOM_HEX
